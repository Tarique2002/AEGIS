# ==============================================================================
# AEGIS Platform Configuration
# ==============================================================================

# Application
ENVIRONMENT=development
DEBUG=true
APP_NAME=AEGIS
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
SECRET_KEY=development_secret_key_change_in_production_min_32_chars

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aegis_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aegis_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_URL=http://localhost:6333

# LLM Providers
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Safety & Platform Hardening (Phase 8)
SAFETY_ENABLED=true
MAX_RISK_LEVEL=CRITICAL
APPROVAL_REQUIRED_ABOVE=MEDIUM
RATE_LIMIT_ENABLED=true
TOKEN_REVOCATION_ENABLED=true

# Audit Checkpoints & Cryptographic Signing (Phases 9 & 10)
AUDIT_SIGNING_KEY=
AEGIS_KMS_KEY_ID=
