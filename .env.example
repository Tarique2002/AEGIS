# ==============================================================================
# AEGIS Platform Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE
# ------------------------------------------------------------------------------
# [PRODUCTION REQUIRED] Deployment environment: development | staging | production | testing
ENVIRONMENT=development

# [OPTIONAL / LOCAL DEV ONLY] Enable FastAPI interactive debug mode (set false in production)
DEBUG=false

# [OPTIONAL] Application metadata and prefix
APP_NAME=AEGIS
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# [OPTIONAL] Server bind host and port (Render dynamically sets PORT)
HOST=0.0.0.0
PORT=8000

# [PRODUCTION REQUIRED] Cryptographic secret key for signing JWT tokens (min 32 chars)
SECRET_KEY=replace_with_a_secure_random_production_secret_key_minimum_32_chars

# [OPTIONAL / PRODUCTION RECOMMENDED] Dedicated JWT secrets (aliases for SECRET_KEY)
JWT_SECRET=
JWT_REFRESH_SECRET=

# [PRODUCTION REQUIRED] Allowed CORS origins (comma-separated list, e.g., "https://app.aegis.io,http://localhost:3000" or "*")
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 2. LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------
# [OPTIONAL] Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# [OPTIONAL] Log format: json (recommended for production) | text
LOG_FORMAT=json

# ------------------------------------------------------------------------------
# 3. POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# [PRODUCTION REQUIRED] Asynchronous database connection string (PostgreSQL)
# e.g., postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aegis_db

# [LOCAL DEV ONLY] Individual DB connection fields used if DATABASE_URL is not provided
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aegis_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 4. REDIS CACHE & WORKING MEMORY
# ------------------------------------------------------------------------------
# [PRODUCTION REQUIRED] Redis connection string for Working Memory and token revocation
# e.g., redis://default:password@host:6379/0 or rediss:// for TLS
REDIS_URL=redis://localhost:6379/0

# [LOCAL DEV ONLY] Individual Redis connection fields used if REDIS_URL is not provided
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------------------
# 5. QDRANT VECTOR DATABASE (SEMANTIC MEMORY)
# ------------------------------------------------------------------------------
# [PRODUCTION REQUIRED] Qdrant Cloud or self-hosted endpoint
QDRANT_URL=http://localhost:6333

# [PRODUCTION REQUIRED for Qdrant Cloud / OPTIONAL for local dev] Qdrant API Key
QDRANT_API_KEY=

# [LOCAL DEV ONLY] Individual Qdrant connection fields used if QDRANT_URL is not provided
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ------------------------------------------------------------------------------
# 6. LLM PROVIDERS
# ------------------------------------------------------------------------------
# [OPTIONAL] Active LLM provider: ollama | openai | anthropic | gemini (defaults to ollama)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2

# [OPTIONAL / LOCAL DEV ONLY] Local Ollama API server base URL
OLLAMA_BASE_URL=http://localhost:11434

# [PRODUCTION OPTIONAL] API keys for external cloud LLM providers (leave empty if using Ollama/Mock)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 7. SAFETY GATES & PLATFORM HARDENING (Phase 8)
# ------------------------------------------------------------------------------
# [OPTIONAL] Centralized safety policy enforcement
SAFETY_ENABLED=true
MAX_RISK_LEVEL=CRITICAL
APPROVAL_REQUIRED_ABOVE=MEDIUM
RATE_LIMIT_ENABLED=true
TOKEN_REVOCATION_ENABLED=true

# ------------------------------------------------------------------------------
# 8. AUDIT CHECKPOINTS & CRYPTOGRAPHIC SIGNING (Phases 9 & 10)
# ------------------------------------------------------------------------------
# [PRODUCTION RECOMMENDED] Dedicated HMAC-SHA256 signing secret for audit checkpoints
AUDIT_SIGNING_KEY=
SIGNING_SECRET=

# [PRODUCTION OPTIONAL] Cloud KMS Key ID (e.g. AWS KMS ARN or GCP KMS Key ID) if using KMS provider
AEGIS_KMS_KEY_ID=
